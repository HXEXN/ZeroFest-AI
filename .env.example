# ZeroFest AI는 키 없이도 Mock Weather + Grounded Chat으로 실행됩니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WEATHER_API_KEY=
WEATHER_PROVIDER=mock

# 비워두면 2023–2025 Sample/Synthetic History를 사용합니다.
# 실제 과거 축제 CSV를 연결할 때 절대경로를 지정하세요.
HISTORICAL_DATA_PATH=

# 예상 잔여 재고 / 현재 재고 비율 기준
RISK_LOW_THRESHOLD=0.10
RISK_HIGH_THRESHOLD=0.30
